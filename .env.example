# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git.

# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL="mysql://user:password@host:3306/dbname"
# DATABASE_PROVIDER="bluehost"   # or "railway", "aiven" etc. when you migrate

# ─── Application ─────────────────────────────────────────────────────────────
NODE_ENV="development"
APP_URL="http://localhost:3000"

# ─── NextAuth (added in M2) ──────────────────────────────────────────────────
# NEXTAUTH_URL="http://localhost:3000"
# NEXTAUTH_SECRET=""             # generate: openssl rand -base64 32
# CRON_SECRET=""                 # generate: openssl rand -base64 32

# ─── OAuth providers (added in M2) ───────────────────────────────────────────
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
# FACEBOOK_CLIENT_ID=""
# FACEBOOK_CLIENT_SECRET=""

# ─── Email — Resend (added in M2) ────────────────────────────────────────────
# RESEND_API_KEY=""
# RESEND_FROM_EMAIL="hello@yourdomain.com"

# ─── AI — OpenAI (added in M7) ───────────────────────────────────────────────
# OPENAI_API_KEY=""

# ─── Storage — Cloudflare R2 (added in M10) ──────────────────────────────────
# R2_ACCOUNT_ID=""
# R2_ACCESS_KEY_ID=""
# R2_SECRET_ACCESS_KEY=""
# R2_BUCKET_NAME="focus-forge-praise-audio"
# R2_PUBLIC_URL=""               # leave blank — signed URLs only

# ─── Body Doubling — Jitsi (added in M11) ────────────────────────────────────
# JITSI_DOMAIN="meet.jit.si"
