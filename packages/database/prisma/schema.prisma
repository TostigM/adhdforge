// Focus Forge — Prisma Schema
// ─────────────────────────────────────────────────────────────────────────────
// Canonical schema spec: files/04-mysql-schema.md
//
// Conventions (per AGENTS.md §5.3 and 04-mysql-schema.md §2):
//   • Primary keys: cuid() stored as VARCHAR(30). NOT UUID. NOT BINARY(16).
//   • Column names: snake_case via @map()
//   • Table names: snake_case via @@map()
//   • Timestamps: created_at / updated_at on every table
//   • NextAuth v4 Prisma adapter models: Account, Session, VerificationToken
//     are mapped to our table names with our extra columns added alongside
//     NextAuth's required fields.
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum UserAccountState {
  unverified
  active
  paused
  suspended
  pending_delete
  deleted
}

enum UserTier {
  free
  legacy_free
  comp
  paid
  paid_lifetime
}

// Subset of UserTier — comp reverts to one of these when it expires.
enum CompPreviousTier {
  free
  legacy_free
  paid
  paid_lifetime
}

enum PendingDeleteInitiator {
  user
  admin
}

// ─── Users ───────────────────────────────────────────────────────────────────
// Full model per 04-mysql-schema.md §4.1
// Also satisfies NextAuth User interface (name, email, emailVerified, image).

model User {
  id    String @id @default(cuid())
  email String @unique @db.VarChar(254)

  // NextAuth compatibility fields
  name          String?   @map("display_name") @db.VarChar(80)
  image         String?   // Not used by Focus Forge; here for NextAuth adapter compat
  emailVerified DateTime? @map("email_verified_at")

  passwordHash String? @map("password_hash") @db.VarChar(255)

  // Account state machine — see doc 01 §4
  accountState    UserAccountState @default(unverified) @map("account_state")
  pausedAt        DateTime?        @map("paused_at")
  pausedUntil     DateTime?        @map("paused_until")
  pausedReason    String?          @map("paused_reason") @db.VarChar(500)
  suspendedAt     DateTime?        @map("suspended_at")
  suspendedReason String?          @map("suspended_reason") @db.VarChar(500)

  // Tier — see doc 01 §5
  tier                 UserTier          @default(free)
  compExpiresAt        DateTime?         @map("comp_expires_at")
  compGrantedByAdminId String?           @map("comp_granted_by_admin_id") @db.VarChar(30)
  compReason           String?           @map("comp_reason") @db.VarChar(500)
  compPreviousTier     CompPreviousTier? @map("comp_previous_tier")

  // Preferences — sparse JSON, evolves without migrations
  preferences Json?

  // Pending deletion
  pendingDeleteAt          DateTime?               @map("pending_delete_at")
  pendingDeleteInitiatedBy PendingDeleteInitiator? @map("pending_delete_initiated_by")
  pendingDeleteAdminId     String?                 @map("pending_delete_admin_id") @db.VarChar(30)

  lastLoginAt DateTime? @map("last_login_at")
  lastLoginIp Bytes?    @map("last_login_ip") @db.VarBinary(16)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  accounts                   Account[]
  sessions                   Session[]
  featureGrants              FeatureGrant[]
  auditLogs                  AuditLog[]
  adminActionsAsAdmin        AdminAction[]          @relation("AdminActionsAsAdmin")
  adminActionsAsTarget       AdminAction[]          @relation("AdminActionsAsTarget")
  compGrantedByAdmin         User?                  @relation("CompGrants", fields: [compGrantedByAdminId], references: [id], onDelete: SetNull)
  compGrantedToUsers         User[]                 @relation("CompGrants")
  pendingDeleteAdmin         User?                  @relation("PendingDeleteAdmin", fields: [pendingDeleteAdminId], references: [id], onDelete: SetNull)
  pendingDeleteAdminForUsers User[]                 @relation("PendingDeleteAdmin")
  passwordResetTokens        PasswordResetToken[]
  emailVerificationTokens    EmailVerificationToken[]

  @@index([accountState])
  @@index([pendingDeleteAt])
  @@index([pausedUntil])
  @@index([compExpiresAt])
  @@map("users")
}

// ─── Auth Methods (NextAuth Account) ─────────────────────────────────────────
// Maps to auth_methods table. Stores OAuth provider links per user.
// NextAuth required fields kept alongside our extra metadata field.
// See 04-mysql-schema.md §4.2

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id") @db.VarChar(30)
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id") @db.VarChar(255)

  // OAuth tokens — NextAuth PrismaAdapter passes these exact snake_case names.
  // Do NOT rename to camelCase — the adapter calls prisma.account.create({ access_token, ... })
  refresh_token String? @db.Text
  access_token  String? @db.Text
  expires_at    Int?
  token_type    String?
  scope         String?
  id_token      String? @db.Text
  session_state String?

  // Our extra fields
  metadata   Json?
  lastUsedAt DateTime? @map("last_used_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("auth_methods")
}

// ─── Sessions (NextAuth Session) ─────────────────────────────────────────────
// Database sessions — cookie holds only the session token.
// 30-day sliding window. "Remember me" is always on per doc 01 §3.1.

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token") @db.VarChar(500)
  userId       String   @map("user_id") @db.VarChar(30)
  expires      DateTime

  // Our extra fields
  userAgent    String?  @map("user_agent") @db.VarChar(500)
  ipAddress    Bytes?   @map("ip_address") @db.VarBinary(16)
  lastActiveAt DateTime @default(now()) @map("last_active_at")
  createdAt    DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expires])
  @@map("sessions")
}

// ─── Verification Tokens (NextAuth VerificationToken) ────────────────────────
// Used by NextAuth Email provider for magic link delivery.
// See 04-mysql-schema.md §4.4

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ─── Password Reset Tokens ───────────────────────────────────────────────────
// Custom — not part of NextAuth. 60-min expiry, single-use.
// See 04-mysql-schema.md §4.4

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String    @map("user_id") @db.VarChar(30)
  email     String    @db.VarChar(254)
  tokenHash Bytes     @map("token_hash") @db.Binary(32)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tokenHash])
  @@index([email])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

// ─── Email Verification Tokens ───────────────────────────────────────────────
// 6-digit code AND click-link (doc 01 §8). 7-day expiry.

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String    @map("user_id") @db.VarChar(30)
  email     String    @db.VarChar(254)
  tokenHash Bytes     @map("token_hash") @db.Binary(32)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tokenHash])
  @@index([email])
  @@index([expiresAt])
  @@map("email_verification_tokens")
}

// ─── Feature Grants ──────────────────────────────────────────────────────────
// Dual purpose: (1) admin permission keys (admin_*), (2) user feature access.
// The legacy-user commitment is enforced here at the data layer — rows are
// never deleted, only revoked (revokedAt set). See doc 01 §5.2 and §4.7.

model FeatureGrant {
  id               String    @id @default(cuid())
  userId           String    @map("user_id") @db.VarChar(30)
  featureKey       String    @map("feature_key") @db.VarChar(100)
  grantedAt        DateTime  @default(now()) @map("granted_at")
  expiresAt        DateTime? @map("expires_at")
  grantedByAdminId String?   @map("granted_by_admin_id") @db.VarChar(30)
  revokedAt        DateTime? @map("revoked_at")
  revokedByAdminId String?   @map("revoked_by_admin_id") @db.VarChar(30)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, featureKey])
  @@index([userId])
  @@map("feature_grants")
}

// ─── Audit Log ───────────────────────────────────────────────────────────────
// User-visible event history (logins, password changes, etc.).
// Entries survive CASCADE on user delete — anonymised but kept for security audit.
// See doc 01 §4.7

model AuditLog {
  id        String   @id @default(cuid())
  userId    String   @map("user_id") @db.VarChar(30)
  eventType String   @map("event_type") @db.VarChar(100)
  metadata  Json?
  ipAddress Bytes?   @map("ip_address") @db.VarBinary(16)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("audit_log")
}

// ─── Admin Actions ───────────────────────────────────────────────────────────
// Admin accountability trail. Both FKs use SET NULL so the trail survives
// deletion of the admin OR the target. See doc 01 §4.7 and 04-mysql-schema.md §4.28

model AdminAction {
  id            String   @id @default(cuid())
  adminUserId   String?  @map("admin_user_id") @db.VarChar(30)  // SET NULL on admin delete
  targetUserId  String?  @map("target_user_id") @db.VarChar(30) // SET NULL on target delete
  action        String   @db.VarChar(100)
  justification String?  @db.VarChar(2000)
  metadata      Json?
  stateBefore   Json?    @map("state_before")
  ipAddress     Bytes?   @map("ip_address") @db.VarBinary(16)
  userAgent     String?  @map("user_agent") @db.VarChar(500)
  createdAt     DateTime @default(now()) @map("created_at")

  adminUser  User? @relation("AdminActionsAsAdmin", fields: [adminUserId], references: [id], onDelete: SetNull)
  targetUser User? @relation("AdminActionsAsTarget", fields: [targetUserId], references: [id], onDelete: SetNull)

  @@index([adminUserId])
  @@index([targetUserId])
  @@index([createdAt])
  @@map("admin_actions")
}
