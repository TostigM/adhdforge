// Focus Forge — Prisma Schema
// ─────────────────────────────────────────────────────────────────────────────
// Canonical schema spec: files/04-mysql-schema.md
//
// Conventions (per AGENTS.md §5.3 and 04-mysql-schema.md §2):
//   • Primary keys: cuid() stored as VARCHAR(30). NOT UUID. NOT BINARY(16).
//   • Column names: snake_case via @map()
//   • Table names: snake_case via @@map()
//   • Timestamps: created_at / updated_at on every table
//   • NextAuth v4 Prisma adapter models: Account, Session, VerificationToken
//     are mapped to our table names with our extra columns added alongside
//     NextAuth's required fields.
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum UserAccountState {
  unverified
  active
  paused
  suspended
  pending_delete
  deleted
}

enum UserTier {
  free
  legacy_free
  comp
  paid
  paid_lifetime
}

// Subset of UserTier — comp reverts to one of these when it expires.
enum CompPreviousTier {
  free
  legacy_free
  paid
  paid_lifetime
}

enum PendingDeleteInitiator {
  user
  admin
}

// ─── Users ───────────────────────────────────────────────────────────────────
// Full model per 04-mysql-schema.md §4.1
// Also satisfies NextAuth User interface (name, email, emailVerified, image).

model User {
  id    String @id @default(cuid())
  email String @unique @db.VarChar(254)

  // NextAuth compatibility fields
  name          String?   @map("display_name") @db.VarChar(80)
  image         String?   // Not used by Focus Forge; here for NextAuth adapter compat
  emailVerified DateTime? @map("email_verified_at")

  passwordHash String? @map("password_hash") @db.VarChar(255)

  // Account state machine — see doc 01 §4
  accountState    UserAccountState @default(unverified) @map("account_state")
  pausedAt        DateTime?        @map("paused_at")
  pausedUntil     DateTime?        @map("paused_until")
  pausedReason    String?          @map("paused_reason") @db.VarChar(500)
  suspendedAt     DateTime?        @map("suspended_at")
  suspendedReason String?          @map("suspended_reason") @db.VarChar(500)

  // Tier — see doc 01 §5
  tier                 UserTier          @default(free)
  compExpiresAt        DateTime?         @map("comp_expires_at")
  compGrantedByAdminId String?           @map("comp_granted_by_admin_id") @db.VarChar(30)
  compReason           String?           @map("comp_reason") @db.VarChar(500)
  compPreviousTier     CompPreviousTier? @map("comp_previous_tier")

  // Preferences — sparse JSON, evolves without migrations
  preferences Json?

  // Pending deletion
  pendingDeleteAt          DateTime?               @map("pending_delete_at")
  pendingDeleteInitiatedBy PendingDeleteInitiator? @map("pending_delete_initiated_by")
  pendingDeleteAdminId     String?                 @map("pending_delete_admin_id") @db.VarChar(30)

  lastLoginAt DateTime? @map("last_login_at")
  lastLoginIp Bytes?    @map("last_login_ip") @db.VarBinary(16)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  accounts                   Account[]
  sessions                   Session[]
  featureGrants              FeatureGrant[]
  auditLogs                  AuditLog[]
  adminActionsAsAdmin        AdminAction[]          @relation("AdminActionsAsAdmin")
  adminActionsAsTarget       AdminAction[]          @relation("AdminActionsAsTarget")
  compGrantedByAdmin         User?                  @relation("CompGrants", fields: [compGrantedByAdminId], references: [id], onDelete: SetNull)
  compGrantedToUsers         User[]                 @relation("CompGrants")
  pendingDeleteAdmin         User?                  @relation("PendingDeleteAdmin", fields: [pendingDeleteAdminId], references: [id], onDelete: SetNull)
  pendingDeleteAdminForUsers User[]                 @relation("PendingDeleteAdmin")
  passwordResetTokens        PasswordResetToken[]
  emailVerificationTokens    EmailVerificationToken[]
  tasks                      Task[]
  dailyPlans                 DailyPlan[]
  userBadges                 UserBadge[]
  events                     Event[]
  quotaUsages                QuotaUsage[]
  focusSessions              FocusSession[]
  scheduledAlerts            ScheduledAlert[]
  launchpadItems             LaunchpadItem[]
  trustedContacts            TrustedContact[]
  praiseMemos                PraiseMemo[]
  contentReportsFiled        ContentReport[]        @relation("ContentReportsFiled")
  contentReportsAgainst      ContentReport[]        @relation("ContentReportsAgainst")
  contentReportsReviewed     ContentReport[]        @relation("ContentReportsReviewed")

  @@index([accountState])
  @@index([pendingDeleteAt])
  @@index([pausedUntil])
  @@index([compExpiresAt])
  @@map("users")
}

// ─── Auth Methods (NextAuth Account) ─────────────────────────────────────────
// Maps to auth_methods table. Stores OAuth provider links per user.
// NextAuth required fields kept alongside our extra metadata field.
// See 04-mysql-schema.md §4.2

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id") @db.VarChar(30)
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id") @db.VarChar(255)

  // OAuth tokens — NextAuth PrismaAdapter passes these exact snake_case names.
  // Do NOT rename to camelCase — the adapter calls prisma.account.create({ access_token, ... })
  refresh_token String? @db.Text
  access_token  String? @db.Text
  expires_at    Int?
  token_type    String?
  scope         String?
  id_token      String? @db.Text
  session_state String?

  // Our extra fields
  metadata   Json?
  lastUsedAt DateTime? @map("last_used_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("auth_methods")
}

// ─── Sessions (NextAuth Session) ─────────────────────────────────────────────
// Database sessions — cookie holds only the session token.
// 30-day sliding window. "Remember me" is always on per doc 01 §3.1.

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token") @db.VarChar(500)
  userId       String   @map("user_id") @db.VarChar(30)
  expires      DateTime

  // Our extra fields
  userAgent    String?  @map("user_agent") @db.VarChar(500)
  ipAddress    Bytes?   @map("ip_address") @db.VarBinary(16)
  lastActiveAt DateTime @default(now()) @map("last_active_at")
  createdAt    DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expires])
  @@map("sessions")
}

// ─── Verification Tokens (NextAuth VerificationToken) ────────────────────────
// Used by NextAuth Email provider for magic link delivery.
// See 04-mysql-schema.md §4.4

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ─── Password Reset Tokens ───────────────────────────────────────────────────
// Custom — not part of NextAuth. 60-min expiry, single-use.
// See 04-mysql-schema.md §4.4

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String    @map("user_id") @db.VarChar(30)
  email     String    @db.VarChar(254)
  tokenHash Bytes     @map("token_hash") @db.Binary(32)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tokenHash])
  @@index([email])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

// ─── Email Verification Tokens ───────────────────────────────────────────────
// 6-digit code AND click-link (doc 01 §8). 7-day expiry.

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String    @map("user_id") @db.VarChar(30)
  email     String    @db.VarChar(254)
  tokenHash Bytes     @map("token_hash") @db.Binary(32)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tokenHash])
  @@index([email])
  @@index([expiresAt])
  @@map("email_verification_tokens")
}

// ─── Feature Grants ──────────────────────────────────────────────────────────
// Dual purpose: (1) admin permission keys (admin_*), (2) user feature access.
// The legacy-user commitment is enforced here at the data layer — rows are
// never deleted, only revoked (revokedAt set). See doc 01 §5.2 and §4.7.

model FeatureGrant {
  id               String    @id @default(cuid())
  userId           String    @map("user_id") @db.VarChar(30)
  featureKey       String    @map("feature_key") @db.VarChar(100)
  grantedAt        DateTime  @default(now()) @map("granted_at")
  expiresAt        DateTime? @map("expires_at")
  grantedByAdminId String?   @map("granted_by_admin_id") @db.VarChar(30)
  revokedAt        DateTime? @map("revoked_at")
  revokedByAdminId String?   @map("revoked_by_admin_id") @db.VarChar(30)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, featureKey])
  @@index([userId])
  @@map("feature_grants")
}

// ─── Audit Log ───────────────────────────────────────────────────────────────
// User-visible event history (logins, password changes, etc.).
// Entries survive CASCADE on user delete — anonymised but kept for security audit.
// See doc 01 §4.7

model AuditLog {
  id        String   @id @default(cuid())
  userId    String   @map("user_id") @db.VarChar(30)
  eventType String   @map("event_type") @db.VarChar(100)
  metadata  Json?
  ipAddress Bytes?   @map("ip_address") @db.VarBinary(16)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("audit_log")
}

// ─── Tasks ───────────────────────────────────────────────────────────────────
// Full model per 04-mysql-schema.md §4.5 (includes M4.5 columns)
// Soft-Track Protocol: status cannot be 'failed'. priority_level cannot be 'urgent'.

enum TaskPriorityKind {
  anchor   // time-bound, pinned to scheduled_for
  flexible // user-decides-when; flows through the bubble-up queue
}

enum TaskPriorityLevel {
  cant_miss // non-negotiable — ANCHOR ONLY (enforced by app CHECK logic)
  high
  med
  low
}

enum TaskStatus {
  active
  deferred
  completed
  // 'failed' and 'overdue' are physically absent — Soft-Track Protocol
}

enum TaskCaptureMethod {
  text
  voice
  imported
  system
}

model Task {
  id     String @id @default(cuid())
  userId String @map("user_id") @db.VarChar(30)

  rawText String @map("raw_text") @db.Text
  title   String? @db.VarChar(500)
  notes   String? @db.Text

  // Priority — anchor/flexible model (see §4.5)
  priorityKind  TaskPriorityKind  @default(flexible) @map("priority_kind")
  priorityLevel TaskPriorityLevel @default(med) @map("priority_level")

  // Gentle-Reframe / Today-queue bookkeeping (see §4.6.2)
  todaySwapCount       Int       @default(0) @map("today_swap_count") @db.UnsignedSmallInt
  reframeOfferedAt     DateTime? @map("reframe_offered_at")
  reframeSnoozedUntil  DateTime? @map("reframe_snoozed_until")

  status TaskStatus @default(active)

  scheduledFor      DateTime? @map("scheduled_for")
  estimatedMinutes  Int?      @map("estimated_minutes") @db.UnsignedSmallInt

  completedAt   DateTime? @map("completed_at")
  deferredCount Int       @default(0) @map("deferred_count") @db.UnsignedSmallInt
  deferredUntil DateTime? @map("deferred_until")

  captureMethod TaskCaptureMethod @default(text) @map("capture_method")
  aiMetadata    Json?             @map("ai_metadata")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt     @map("updated_at")

  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  steps         TaskStep[]
  dailyPlanItems DailyPlanItem[]
  focusSessions FocusSession[]

  @@index([userId, status, createdAt])
  @@index([userId, scheduledFor])
  @@index([deferredUntil])
  @@index([userId, status, priorityKind, priorityLevel], name: "idx_tasks_today_queue")
  @@map("tasks")
}

// ─── Task Steps ───────────────────────────────────────────────────────────────
// Sub-steps for "Walk Me Through It" mode. See §4.6

enum TaskStepStatus {
  active
  completed
  deferred
}

model TaskStep {
  id       String @id @default(cuid())
  taskId   String @map("task_id") @db.VarChar(30)

  stepOrder Int            @map("step_order") @db.UnsignedSmallInt
  text      String         @db.Text
  status    TaskStepStatus @default(active)

  completedAt DateTime? @map("completed_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt     @map("updated_at")

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, stepOrder])
  @@index([taskId, status])
  @@map("task_steps")
}

// ─── Focus Sessions (M6 Analog Timer) ─────────────────────────────────────────
// A focus timer run. See §4.12.
// Soft-Track Protocol: 'incomplete' is neutral, NOT 'failed'.

enum FocusSessionStatus {
  running
  completed
  incomplete
  paused
}

model FocusSession {
  id     String @id @default(cuid())
  userId String @map("user_id") @db.VarChar(30)
  taskId String? @map("task_id") @db.VarChar(30) // optional linked task

  plannedDurationSeconds Int  @map("planned_duration_seconds") @db.UnsignedInt
  actualDurationSeconds  Int? @map("actual_duration_seconds") @db.UnsignedInt

  status FocusSessionStatus @default(running)

  soundFamily          String? @map("sound_family") @db.VarChar(80)
  alertIntervalSeconds Int?    @map("alert_interval_seconds") @db.UnsignedInt

  startedAt DateTime  @default(now()) @map("started_at")
  endedAt   DateTime? @map("ended_at")

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  task Task? @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([userId, startedAt(sort: Desc)])
  @@map("focus_sessions")
}

// ─── Daily Plans + Items (M4.5 Core Loop) ─────────────────────────────────────
// One plan row per user per local day. See §4.6.1 and §4.6.2

enum DailyPlanRitualState {
  pending
  completed
  skipped
}

model DailyPlan {
  id     String @id @default(cuid())
  userId String @map("user_id") @db.VarChar(30)

  planDate      DateTime             @map("plan_date") @db.Date
  visibleSlots  Int                  @default(3) @map("visible_slots") @db.UnsignedTinyInt
  ritualState   DailyPlanRitualState @default(pending) @map("ritual_state")
  ritualCompletedAt DateTime?        @map("ritual_completed_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt     @map("updated_at")

  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items DailyPlanItem[]

  @@unique([userId, planDate])
  @@map("daily_plans")
}

enum DailyPlanItemSlotState {
  today
  queue
  done
}

enum DailyPlanItemSource {
  ritual
  anchor
  bubble
  manual
}

model DailyPlanItem {
  id          String @id @default(cuid())
  dailyPlanId String @map("daily_plan_id") @db.VarChar(30)
  taskId      String @map("task_id") @db.VarChar(30)

  slotState   DailyPlanItemSlotState @default(queue) @map("slot_state")
  position    Int                    @default(0) @map("position") @db.UnsignedSmallInt
  source      DailyPlanItemSource    @default(bubble)

  addedAt     DateTime  @default(now()) @map("added_at")
  completedAt DateTime? @map("completed_at")

  dailyPlan DailyPlan @relation(fields: [dailyPlanId], references: [id], onDelete: Cascade)
  task      Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([dailyPlanId, taskId])
  @@index([dailyPlanId, slotState, position])
  @@map("daily_plan_items")
}

// ─── Badges ───────────────────────────────────────────────────────────────────
// Badge definitions (seeded) + earned instances. See §4.8

enum BadgeTier {
  bronze
  silver
  gold
}

model Badge {
  id          String    @id @default(cuid())
  badgeKey    String    @unique @map("badge_key") @db.VarChar(80)
  displayName String    @map("display_name") @db.VarChar(120)
  description String    @db.VarChar(500)
  tier        BadgeTier @default(bronze)

  triggerEventType  String? @map("trigger_event_type") @db.VarChar(80)
  triggerThreshold  Int?    @map("trigger_threshold") @db.UnsignedInt
  isRepeatable      Boolean @default(false) @map("is_repeatable")

  iconName String  @map("icon_name") @db.VarChar(80)
  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")

  userBadges UserBadge[]

  @@map("badges")
}

model UserBadge {
  id       String @id @default(cuid())
  userId   String @map("user_id") @db.VarChar(30)
  badgeId  String @map("badge_id") @db.VarChar(30)

  earnedAt DateTime @default(now()) @map("earned_at")
  context  Json?

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge Badge @relation(fields: [badgeId], references: [id])

  @@index([userId, earnedAt(sort: Desc)])
  @@index([badgeId])
  @@map("user_badges")
}

// ─── Scheduled Alerts ─────────────────────────────────────────────────────────
// Future reminders (Doorknob zone transitions, nightly Launchpad, etc.). See §4.14.
// A Doorknob session has no table of its own: it IS its set of pending
// doorknob_zone alerts, linked by payload.sessionId (M8 decision).

enum ScheduledAlertType {
  doorknob_zone
  launchpad_nightly
  task_reminder
  check_in
}

enum ScheduledAlertStatus {
  pending
  fired
  cancelled
}

model ScheduledAlert {
  id     String @id @default(cuid())
  userId String @map("user_id") @db.VarChar(30)

  alertType ScheduledAlertType @map("alert_type")

  scheduledFor DateTime @map("scheduled_for")
  payload      Json?

  status  ScheduledAlertStatus @default(pending)
  firedAt DateTime?            @map("fired_at")

  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, scheduledFor])
  @@index([userId, scheduledFor])
  @@map("scheduled_alerts")
}

// ─── Launchpad ────────────────────────────────────────────────────────────────
// The user's daily "items by the door" (M9). See §4.11.
// Reset model: lazy on read (most recent 04:00 workday-time boundary) with the
// daily cron as an all-users backstop. resetTimeLocal is reserved for per-item
// reset times once per-user timezones land (M15.3) — v1 treats it as 04:00.

enum LaunchpadResetSchedule {
  never
  daily
  on_departure
}

model LaunchpadItem {
  id     String @id @default(cuid())
  userId String @map("user_id") @db.VarChar(30)

  label        String @db.VarChar(120)
  displayOrder Int    @default(0) @map("display_order") @db.UnsignedSmallInt

  isChecked     Boolean   @default(false) @map("is_checked")
  lastCheckedAt DateTime? @map("last_checked_at")

  resetSchedule  LaunchpadResetSchedule @default(daily) @map("reset_schedule")
  resetTimeLocal DateTime?              @map("reset_time_local") @db.Time(0)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, displayOrder], map: "idx_launchpad_user_order")
  @@map("launchpad_items")
}

// ─── Praise Repository (M10) ─────────────────────────────────────────────────
// Trusted contacts record voice memos via account-less invite links. See
// §4.9–4.10, doc 01 §10, and AGENTS.md §5.20 for the locked decisions.

model TrustedContact {
  id     String @id @default(cuid())
  userId String @map("user_id") @db.VarChar(30)

  displayName String @map("display_name") @db.VarChar(80)

  // 256-bit invite token, SHA-256 hashed (raw token only ever lives in the link).
  inviteTokenHash Bytes    @map("invite_token_hash") @db.Binary(32)
  // D2: flat creation+7d expiry; no first-use tracking.
  inviteExpiresAt DateTime @map("invite_expires_at")
  memosRemaining  Int      @default(3) @map("memos_remaining") @db.UnsignedSmallInt

  isRevoked Boolean   @default(false) @map("is_revoked")
  revokedAt DateTime? @map("revoked_at")

  createdAt DateTime @default(now()) @map("created_at")

  user  User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  memos PraiseMemo[]

  @@unique([inviteTokenHash], map: "uq_trusted_contacts_token")
  @@index([userId], map: "idx_trusted_contacts_user")
  @@map("trusted_contacts")
}

enum PraiseTranscriptStatus {
  pending
  completed
  failed_skip
}

model PraiseMemo {
  id               String @id @default(cuid())
  userId           String @map("user_id") @db.VarChar(30)
  trustedContactId String @map("trusted_contact_id") @db.VarChar(30)

  senderDisplayName String @map("sender_display_name") @db.VarChar(80)

  audioPath       String @map("audio_path") @db.VarChar(500)
  audioDurationMs Int    @map("audio_duration_ms") @db.UnsignedInt
  audioSizeBytes  Int    @map("audio_size_bytes") @db.UnsignedInt

  // D5: 'pending' also means "free tier, not transcribed yet" — an upgrade can
  // transcribe retroactively. 'failed_skip' is an actual failure, audio fine.
  transcript       String?                @db.Text
  transcriptStatus PraiseTranscriptStatus @default(pending) @map("transcript_status")

  category String? @db.VarChar(80)

  isArchived   Boolean   @default(false) @map("is_archived")
  lastPlayedAt DateTime? @map("last_played_at")
  playCount    Int       @default(0) @map("play_count") @db.UnsignedInt

  // D4 (owner decision, AGENTS.md §5.20): sender IP kept 7 days for abuse
  // investigation, then nulled by the daily cron. Never surfaced outside an
  // admin content review.
  senderIp Bytes? @map("sender_ip") @db.VarBinary(16)

  createdAt DateTime @default(now()) @map("created_at")

  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  trustedContact TrustedContact @relation(fields: [trustedContactId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)], map: "idx_praise_memos_user_created")
  @@index([userId, category], map: "idx_praise_memos_user_category")
  @@map("praise_memos")
}

// ─── Content Reports (M10, §4.29) ─────────────────────────────────────────────
// Reactive moderation only. A memo with an OPEN report (pending_review /
// reviewing / resolved_action_taken) is hidden from the inbox by QUERY — there
// is no hidden flag, so resolved_no_action restores visibility automatically.

enum ContentReportType {
  praise_memo
  body_doubling_session
  feedback_item
  other
}

enum ContentReportReason {
  inappropriate
  harassment
  spam
  illegal
  other
}

enum ContentReportStatus {
  pending_review
  reviewing
  resolved_no_action
  resolved_action_taken
  duplicate
}

model ContentReport {
  id String @id @default(cuid())

  reporterUserId String  @map("reporter_user_id") @db.VarChar(30)
  reportedUserId String? @map("reported_user_id") @db.VarChar(30)

  contentType ContentReportType @map("content_type")
  contentId   String?           @map("content_id") @db.VarChar(30)

  reasonCategory ContentReportReason @map("reason_category")
  reasonDetails  String?             @map("reason_details") @db.Text

  status ContentReportStatus @default(pending_review)

  reviewedByAdminId String?   @map("reviewed_by_admin_id") @db.VarChar(30)
  reviewedAt        DateTime? @map("reviewed_at")
  reviewNotes       String?   @map("review_notes") @db.Text
  actionTaken       String?   @map("action_taken") @db.VarChar(80)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  reporter User  @relation("ContentReportsFiled", fields: [reporterUserId], references: [id], onDelete: Cascade)
  reported User? @relation("ContentReportsAgainst", fields: [reportedUserId], references: [id], onDelete: SetNull)
  reviewer User? @relation("ContentReportsReviewed", fields: [reviewedByAdminId], references: [id], onDelete: SetNull)

  @@index([status, createdAt(sort: Desc)], map: "idx_reports_status_created")
  @@index([reportedUserId, createdAt(sort: Desc)], map: "idx_reports_reported_user")
  @@index([contentType, contentId], map: "idx_reports_content")
  @@map("content_reports")
}

// ─── Events ───────────────────────────────────────────────────────────────────
// Append-only log. Drives badge engine + analytics. See §4.15

model Event {
  id         String  @id @default(cuid())
  userId     String? @map("user_id") @db.VarChar(30)
  eventType  String  @map("event_type") @db.VarChar(80)
  payload    Json?
  occurredAt DateTime @default(now()) @map("occurred_at")

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, eventType, occurredAt(sort: Desc)])
  @@index([eventType, occurredAt(sort: Desc)])
  @@map("events")
}

// ─── Quota Usage ─────────────────────────────────────────────────────────────
// Daily quota tracking for rate-limited features. See §4.17

model QuotaUsage {
  id           String @id @default(cuid())
  userId       String @map("user_id") @db.VarChar(30)
  quotaKey     String @map("quota_key") @db.VarChar(80)
  usageDateUtc DateTime @map("usage_date_utc") @db.Date
  count        Int    @default(0) @db.UnsignedInt

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt     @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, quotaKey, usageDateUtc])
  @@index([userId, quotaKey])
  @@map("quota_usage")
}

// ─── Admin Actions ───────────────────────────────────────────────────────────
// Admin accountability trail. Both FKs use SET NULL so the trail survives
// deletion of the admin OR the target. See doc 01 §4.7 and 04-mysql-schema.md §4.28

model AdminAction {
  id            String   @id @default(cuid())
  adminUserId   String?  @map("admin_user_id") @db.VarChar(30)  // SET NULL on admin delete
  targetUserId  String?  @map("target_user_id") @db.VarChar(30) // SET NULL on target delete
  action        String   @db.VarChar(100)
  justification String?  @db.VarChar(2000)
  metadata      Json?
  stateBefore   Json?    @map("state_before")
  ipAddress     Bytes?   @map("ip_address") @db.VarBinary(16)
  userAgent     String?  @map("user_agent") @db.VarChar(500)
  createdAt     DateTime @default(now()) @map("created_at")

  adminUser  User? @relation("AdminActionsAsAdmin", fields: [adminUserId], references: [id], onDelete: SetNull)
  targetUser User? @relation("AdminActionsAsTarget", fields: [targetUserId], references: [id], onDelete: SetNull)

  @@index([adminUserId])
  @@index([targetUserId])
  @@index([createdAt])
  @@map("admin_actions")
}
